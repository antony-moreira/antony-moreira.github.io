---
import Base from '../layouts/Base.astro';
import type { Lang } from '../data/site';
import { profile, projects, skills } from '../data/site';
import { ui, other } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const { links } = profile;
---

<Base lang={lang} title={`${profile.name} — ${profile.role[lang]}`} description={profile.tagline[lang]} altHref={ui[other(lang)].home}>
  <section class="wrap hero">
    <p class="eyebrow">{profile.role[lang]}</p>
    <h1>{profile.name}</h1>
    <p class="lead">{profile.tagline[lang]}</p>
    <div class="actions">
      <a class="btn" href="#projects">{t.hero.cta}</a>
      <a class="btn ghost" href={links.github}>{t.hero.github}</a>
      {links.linkedin && <a class="btn ghost" href={links.linkedin}>LinkedIn</a>}
    </div>
  </section>

  <section class="wrap" id="about">
    <h2>{t.about}</h2>
    {profile.about[lang].map((p) => <p class="muted">{p}</p>)}
  </section>

  <section class="wrap" id="projects">
    <h2>{t.projects}</h2>
    <p class="muted">{t.projectsIntro}</p>
    <div class="grid">
      {projects.map((p) => (
        <a class="card project" href={`${t.projectBase}${p.slug[lang]}/`}>
          {p.metric && (
            <p class="metric"><strong>{p.metric.value}</strong> <span>{p.metric.label[lang]}</span></p>
          )}
          <h3>{p.title[lang]}</h3>
          <p class="muted">{p.summary[lang]}</p>
          <ul class="tags">{p.stack.slice(0, 6).map((s) => <li>{s}</li>)}</ul>
          <span class="more">{t.readMore} →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap" id="skills">
    <h2>{t.skills}</h2>
    <div class="grid">
      {skills.map((g) => (
        <div class="card">
          <h3>{g.group[lang]}</h3>
          <ul class="tags">{g.items.map((s) => <li>{s}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap" id="contact">
    <h2>{t.contact}</h2>
    <p class="muted">{t.contactText}</p>
    <div class="actions">
      {links.email && <a class="btn" href={`mailto:${links.email}`}>{links.email}</a>}
      {links.linkedin && <a class="btn ghost" href={links.linkedin}>LinkedIn</a>}
      <a class="btn ghost" href={links.github}>GitHub</a>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 88px; }
  .hero h1 { font-size: clamp(36px, 7vw, 56px); margin: 8px 0 16px; }
  .lead { font-size: 19px; color: var(--muted); max-width: 640px; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-top: 20px; }
  .card h3 { margin: 0 0 8px; font-size: 18px; }
  .project { color: var(--text); display: flex; flex-direction: column; gap: 4px; transition: border-color .15s, transform .15s; }
  .project:hover { text-decoration: none; border-color: var(--accent); transform: translateY(-2px); }
  .project .muted { flex: 1; margin: 0 0 12px; }
  .metric { margin: 0 0 6px; font-size: 13px; color: var(--muted); }
  .metric strong { font-family: var(--mono); font-size: 22px; color: var(--accent); }
  .more { margin-top: 12px; font-size: 14px; color: var(--accent); }
</style>
