---
import type { Lang } from '../data/site';
import { profile } from '../data/site';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  altHref: string; // same page in the other language
}
const { lang, title, description, altHref } = Astro.props;
const t = ui[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'pt-br' ? 'en' : 'pt-BR'} href={new URL(altHref, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={profile.photo} />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      try {
        const s = localStorage.getItem('theme');
        if (s) document.documentElement.dataset.theme = s;
      } catch {}
    </script>
  </head>
  <body>
    <header class="topbar">
      <div class="wrap bar">
        <a class="brand" href={t.home}>{profile.name}</a>
        <nav>
          <a href={`${t.home}#experience`}>{t.nav.experience}</a>
          <a href={`${t.home}#projects`}>{t.nav.projects}</a>
          <a href={`${t.home}#skills`}>{t.nav.skills}</a>
          <a href={`${t.home}#contact`}>{t.nav.contact}</a>
          <a class="pill" href={altHref} hreflang={lang === 'pt-br' ? 'en' : 'pt-BR'}>{t.switchLabel}</a>
          <button id="theme" class="pill" type="button" aria-label="Toggle theme">◐</button>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="wrap foot">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <span>{t.footer}</span>
    </footer>
    <script is:inline>
      document.getElementById('theme').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f8fafc;
    --surface: #ffffff;
    --text: #0f172a;
    --muted: #475569;
    --border: #e2e8f0;
    --accent: #0369a1;
    --accent-soft: #e0f2fe;
    --mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #0b1120;
      --surface: #111a2e;
      --text: #e2e8f0;
      --muted: #94a3b8;
      --border: #1e293b;
      --accent: #38bdf8;
      --accent-soft: #0c2a43;
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #0b1120;
    --surface: #111a2e;
    --text: #e2e8f0;
    --muted: #94a3b8;
    --border: #1e293b;
    --accent: #38bdf8;
    --accent-soft: #0c2a43;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.65 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .wrap { max-width: 960px; margin: 0 auto; padding: 0 16px; }
  .topbar {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 56px; flex-wrap: wrap; }
  .brand { font-family: var(--mono); font-weight: 700; color: var(--text); }
  nav { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; font-size: 14px; }
  nav a { color: var(--muted); }
  .pill {
    border: 1px solid var(--border); border-radius: 999px; padding: 2px 10px;
    background: var(--surface); color: var(--text); font: inherit; font-size: 13px; cursor: pointer;
  }
  section { padding: 56px 0; }
  h1, h2, h3 { line-height: 1.2; }
  h2 { font-size: 26px; margin: 0 0 8px; }
  .eyebrow { font-family: var(--mono); color: var(--accent); font-size: 13px; letter-spacing: .05em; text-transform: uppercase; }
  .muted { color: var(--muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0; list-style: none; }
  .tags li {
    font-family: var(--mono); font-size: 12px; padding: 2px 8px; border-radius: 6px;
    background: var(--accent-soft); color: var(--accent);
  }
  .btn {
    display: inline-block; padding: 10px 18px; border-radius: 8px; font-weight: 600;
    background: var(--accent); color: var(--bg);
  }
  .btn.ghost { background: transparent; color: var(--text); border: 1px solid var(--border); }
  .btn:hover { text-decoration: none; opacity: .9; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; }
  .foot {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;
    border-top: 1px solid var(--border); padding-top: 20px; padding-bottom: 32px;
    color: var(--muted); font-size: 13px;
  }
</style>
